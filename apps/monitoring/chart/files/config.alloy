logging {
  level = "info"
}

// One target per node, including frontend nodes. No pod annotation discovery.
discovery.kubernetes "nodes" {
  role = "node"
}

discovery.relabel "nodes" {
  targets = discovery.kubernetes.nodes.targets
  rule {
    source_labels = ["__meta_kubernetes_node_address_InternalIP"]
    target_label  = "__address__"
    replacement   = "$1:10250"
  }
  rule {
    source_labels = ["__meta_kubernetes_node_name"]
    target_label  = "node"
  }
  rule {
    source_labels = ["__meta_kubernetes_node_name"]
    target_label  = "instance"
  }
}

{{ range $source := list "kubelet" "cadvisor" }}
prometheus.scrape "{{ $source }}" {
  targets         = discovery.relabel.nodes.output
  job_name        = "kubernetes/{{ $source }}"
  scheme          = "https"
  metrics_path    = "{{ if eq $source "cadvisor" }}/metrics/cadvisor{{ else }}/metrics{{ end }}"
  scrape_interval = "60s"
  scrape_timeout  = "10s"
  bearer_token_file = "/var/run/secrets/kubernetes.io/serviceaccount/token"
  tls_config {
    ca_file              = "/var/run/secrets/kubernetes.io/serviceaccount/ca.crt"
    insecure_skip_verify = false
  }
  forward_to = [prometheus.relabel.v1.receiver]
}
{{ end }}

prometheus.scrape "kube_state_metrics" {
  targets = [{
    "__address__" = {{ .Values.metrics.kubeStateMetricsAddress | quote }},
    "instance"    = "kube-state-metrics",
  }]
  job_name        = "kubernetes/kube-state-metrics"
  scrape_interval = "60s"
  scrape_timeout  = "10s"
  forward_to      = [prometheus.relabel.v1.receiver]
}

prometheus.exporter.self "alloy" {}

prometheus.scrape "alloy" {
  targets         = prometheus.exporter.self.alloy.targets
  job_name        = "kubernetes/alloy"
  scrape_interval = "60s"
  scrape_timeout  = "10s"
  forward_to      = [prometheus.relabel.v1.receiver]
}

prometheus.relabel "v1" {
  // Only the metrics consumed by the overview and rollout checks reach AMP.
  rule {
    source_labels = ["__name__"]
    regex = "up|scrape_samples_scraped|scrape_samples_post_metric_relabeling|scrape_duration_seconds|kube_node_info|kube_node_status_condition|kube_node_status_allocatable|kube_pod_info|kube_pod_status_phase|kube_pod_container_status_restarts_total|kube_pod_container_resource_requests|kube_pod_container_resource_limits|kube_deployment_spec_replicas|kube_deployment_status_replicas_available|kube_statefulset_replicas|kube_statefulset_status_replicas_ready|kube_daemonset_status_desired_number_scheduled|kube_daemonset_status_number_ready|kubelet_node_name|container_cpu_usage_seconds_total|container_memory_working_set_bytes|process_resident_memory_bytes|process_cpu_seconds_total|prometheus_remote_storage_samples_pending|prometheus_remote_storage_samples_failed_total|prometheus_remote_storage_samples_retried_total|prometheus_remote_storage_samples_total|prometheus_remote_storage_queue_highest_sent_timestamp_seconds"
    action = "keep"
  }
  // Discard cgroup aggregates; keep real Kubernetes containers only.
  rule {
    source_labels = ["__name__", "container"]
    regex         = "container_(cpu_usage_seconds_total|memory_working_set_bytes);(|POD)"
    action        = "drop"
  }
  rule {
    source_labels = ["job"]
    regex         = "kubernetes/(.*)"
    target_label  = "source"
    replacement   = "$1"
  }
  // Preserve series identity (including cgroup id and cpu); no arbitrary pod labels.
  rule {
    action = "labelkeep"
    regex = "__name__|job|instance|source|node|namespace|pod|uid|container|id|cpu|condition|status|phase|resource|unit|deployment|statefulset|daemonset|component_id|component_path|remote_name|url"
  }
  forward_to = [prometheus.remote_write.amp.receiver]
}

prometheus.remote_write "amp" {
  external_labels = {
    "cluster" = {{ .Values.codeai_cluster_config.cluster_name | quote }},
  }
  endpoint {
    name = "amp"
    url  = {{ .Values.amp.remoteWriteUrl | quote }}
    sigv4 {
      region = {{ .Values.amp.region | quote }}
    }
    send_exemplars = false
    queue_config {
      max_shards       = 4
      capacity         = 10000
      sample_age_limit = "1h"
    }
  }
  wal {
    truncate_frequency = "15m"
    min_keepalive_time  = "5m"
    max_keepalive_time  = "1h"
  }
}
